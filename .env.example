# Local: pnpm db:local (Postgres on port 5434). Production: a Neon connection string.
DATABASE_URL=postgres://blunder:blunder@localhost:5434/blunder

# Claude API key for explanations and the eval grader. Without it, only cached
# explanations (the preloaded sample game) are shown.
ANTHROPIC_API_KEY=

# Contact string sent in the User-Agent to chess.com's public API (they ask for one).
CHESSCOM_CONTACT=

# Rate limits for /api/explain (per IP per hour, and a global daily cap on fresh LLM calls).
RATE_LIMIT_PER_HOUR=30
DAILY_LLM_CAP=500
