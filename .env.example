# Local: pnpm db:local (Postgres on port 5434). Production: a Neon connection string.
DATABASE_URL=postgres://blunder:blunder@localhost:5434/blunder
# Neon's direct (unpooled) URL, used by drizzle-kit for migrations. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=
# Used by the DB-backed tests (lib/llm/__tests__/cache.db.test.ts); they are skipped without it.
# TEST_DATABASE_URL=postgres://blunder:blunder@localhost:5434/blunder

# OPTIONAL. The site's own Claude API key. Visitors can bring their own key (sent per request in
# the x-anthropic-key header, never stored; see docs/byok.md), and a visitor's key is always used
# before this one. Leave it empty so the site pays for nothing: visitors then see cached
# explanations (e.g. the preloaded sample game) and are asked for a key for anything new.
# The eval and precompute scripts still need it. Keep it unset in production: DAILY_LLM_CAP only
# counts explanations that finished and were cached, so aborted or failed calls are not counted.
ANTHROPIC_API_KEY=

# Contact string sent in the User-Agent to chess.com's public API (they ask for one).
# Defaults to this project's GitHub URL when empty.
CHESSCOM_CONTACT=

# Rate limits for /api/explain. Calls paid by ANTHROPIC_API_KEY: per IP per hour, plus a global
# daily cap. Calls paid by a visitor's own key never count toward the daily cap; they only have a
# per-IP hourly limit (RATE_LIMIT_PER_HOUR_BYOK) so the site can't be used as a free proxy at scale.
RATE_LIMIT_PER_HOUR=30
DAILY_LLM_CAP=500
RATE_LIMIT_PER_HOUR_BYOK=120

# Per-IP hourly limit for loading games (/api/game, /api/games), which call chess.com.
RATE_LIMIT_PER_HOUR_GAMES=60

# Proxies in front of the app that append to X-Forwarded-For; the client IP is the entry this
# many places from the right (never the client-written left-most one). Ignored on Vercel,
# which sets x-real-ip itself. 0 = no proxy: every caller shares one rate-limit bucket.
TRUSTED_PROXY_HOPS=1
